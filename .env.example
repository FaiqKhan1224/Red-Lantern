# Set these in Vercel -> Project -> Settings -> Environment Variables
# (and copy to .env for local use together with `npm run seed`)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/red_lantern
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=https://your-project.vercel.app

# Used only by `npm run seed`
ADMIN_EMAIL=admin@redlantern.com
ADMIN_PASSWORD=ChangeMe@12345

# Email (optional - without it, emails are just logged)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Red Lantern" <your-address@gmail.com>
