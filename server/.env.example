# Copy this file to ".env" (same folder) and edit the values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/red_lantern
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Admin account created by "npm run seed"
ADMIN_EMAIL=admin@redlantern.com
ADMIN_PASSWORD=ChangeMe@12345

# ── Email (reservation notifications) ──
# Leave SMTP_USER / SMTP_PASS empty to print emails in the server terminal (development only).
# Gmail example: turn on 2-Step Verification, create an "App password" and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Red Lantern" <your-address@gmail.com>
